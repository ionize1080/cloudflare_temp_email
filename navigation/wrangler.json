{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ionacs-navigation",
  "main": "src/worker.mjs",
  "account_id": "9e7dc30189a7850a649886ffa37182ee",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "ionacs.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://ionacs.com",
    "ADMIN_EMAIL": "adrian@ionacs.com",
    "TURNSTILE_SITE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maildata",
      "database_id": "51d8c8f2-6139-4a6c-ad85-40668d0c45d2",
      "migrations_dir": "migrations",
      "migrations_table": "nav_migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1010",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1011",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "15 */6 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "kv_namespaces": [
    {
      "binding": "WALLPAPERS",
      "id": "4bc0c8bef04d416196e5d47a15dee3db"
    }
  ]
}
